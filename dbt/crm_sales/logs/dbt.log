    ON s.deal_stage = ds.deal_stage

LEFT JOIN "crm_sales"."main_dwh"."dim_date" d_engage
    ON s.engage_date = d_engage.full_date

LEFT JOIN "crm_sales"."main_dwh"."dim_date" d_close
    ON s.close_date = d_close.full_date
    );
    
  
